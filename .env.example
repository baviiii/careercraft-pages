# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Public frontend URL used for auth email/OAuth redirects
VITE_PUBLIC_APP_URL=https://your-production-domain.com

# ============================================
# AZURE OPENAI CONFIGURATION (REQUIRED)
# ============================================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ============================================
# AZURE DOCUMENT INTELLIGENCE (OPTIONAL)
# ============================================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-doc-intel-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key-here

# ============================================
# AZURE AI SEARCH (REQUIRED FOR INTELLIGENCE)
# ============================================
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key-here
AZURE_SEARCH_INDEX=sa-gov-documents

# ============================================
# JOB SEARCH API KEYS (OPTIONAL)
# ============================================
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
JSEARCH_API_KEY=your-jsearch-api-key
CURRENTS_API_KEY=your-currents-api-key

# ============================================
# ANTHROPIC CLAUDE API (REQUIRED FOR ONBOARDING)
# ============================================
# Powers the onboard-analyze edge function (Claude Sonnet 4.6).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# LOVABLE AI API (OPTIONAL)
# ============================================
LOVABLE_API_KEY=your-lovable-api-key-here

# ============================================
# INTERVIEW COACH MCP (REQUIRED FOR LIVE INTERVIEW PREP)
# ============================================
# Base URL of the running interview-coach-mcp server. When set, the Interview
# Prep page routes question generation, answer evaluation, final grading and
# source-backed resources/tips through it (real Gemini gateway + Hacker News
# grounding + RLS-scoped Supabase). When UNSET or unreachable, those features
# show "not available at the moment" — never mock data.
VITE_INTERVIEW_MCP_URL=http://localhost:8787

# ============================================
# AZURE FUNCTIONS
# ============================================
VITE_AZURE_FUNCTIONS_URL=https://careercraft-functions-dev.azurewebsites.net
VITE_AZURE_FUNCTIONS_KEY=

# ============================================
# AGENTIC RAG AZURE FUNCTIONS (FOR ADVANCED MODE)
# ============================================
VITE_AZURE_AGENTIC_PLANNER_URL=https://your-functions.azurewebsites.net/api/agentic-planner
VITE_AZURE_INTERSECTION_REASONING_URL=https://your-functions.azurewebsites.net/api/intersection-reasoning
VITE_AZURE_ENTITY_EXTRACTION_URL=https://your-functions.azurewebsites.net/api/entity-extraction
VITE_AZURE_GRAPH_QUERY_URL=https://your-functions.azurewebsites.net/api/graph-query
VITE_AZURE_FUNCTION_KEY=your-function-key-here

# ============================================
# AZURE COSMOS DB (GREMLIN API) - FOR GRAPH RAG
# ============================================
# Deploy with: az deployment group create --resource-group rg-careercraft-dev --template-file infrastructure/cosmos-graph.bicep
COSMOS_GREMLIN_ENDPOINT=wss://careercraft-graph.gremlin.cosmos.azure.com:443/
COSMOS_PRIMARY_KEY=your-cosmos-primary-key-here
COSMOS_DATABASE=graphdb
COSMOS_GRAPH=career-graph

# Get the key with:
# az cosmosdb keys list --name careercraft-graph --resource-group rg-careercraft-dev --query primaryMasterKey -o tsv