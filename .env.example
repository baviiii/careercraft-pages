# ============================================
# SUPABASE CONFIGURATION
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Public frontend URL used for auth email/OAuth redirects
VITE_PUBLIC_APP_URL=https://your-production-domain.com

# Optional override for the Cloudflare Turnstile SITE key. The real (public)
# key is in src/components/auth/CaptchaField.tsx; set this only to swap in
# Cloudflare's test keys. The SECRET key lives in Supabase → Authentication →
# Attack Protection, never here.
# VITE_TURNSTILE_SITE_KEY=

# ============================================
# AZURE OPENAI CONFIGURATION (REQUIRED)
# ============================================
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key-here
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ── REMOVED: Document Intelligence + the `sa-gov-documents` search index ─────
# Document ingestion and retrieval now live in Horus (see HORUS_BASE_URL below).
# Documents are extracted by Azure Content Understanding through an AI Search
# indexer and served from the `horus-knowledge` index. CareerCraft holds no
# search or extraction credentials of its own.

# ============================================
# JOB SEARCH API KEYS (OPTIONAL)
# ============================================
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
JSEARCH_API_KEY=your-jsearch-api-key
CURRENTS_API_KEY=your-currents-api-key

# ============================================
# HORUS INFERENCE GATEWAY (REQUIRED FOR AI FEATURES)
# ============================================
# All edge-function text generation (onboarding, ATS analysis, rewrites,
# cover letters, job-news trends, prompt authoring) goes through the deployed
# horus-platform gateway. The key is a Horus tenant API key with the
# `intelligence:infer` scope (create one in the Horus admin UI).
HORUS_INFER_URL=https://your-horus-deployment.vercel.app/api/infer
HORUS_API_KEY=your-horus-tenant-api-key-here

# ============================================
# HORUS KNOWLEDGE (RAG CORPUS + GRAPH)
# ============================================
# Retrieval and knowledge-graph reads, served by the `horus-rag` edge function.
# HORUS_BASE_URL is the deployment ORIGIN (no path) — the client appends
# /api/trpc itself. HORUS_API_KEY above is reused; mint it read-only with:
#   pnpm exec tsx scripts/mint-consumer-key.ts --tenant=careercraft \
#     --name="CareerCraft web" --scopes=rag:read,graph:read,entities:read,documents:read
#
# NEVER expose this key to the browser. It is deliberately NOT a VITE_ variable:
# Vite inlines VITE_* into the client bundle, so anything prefixed that way is
# public. The browser talks to the edge function, which holds the key.
HORUS_BASE_URL=https://your-horus-deployment.vercel.app

# Frontend kill-switch for the Horus retrieval path. Unset/anything = enabled.
# Set to "off" to fall back to the legacy Azure Functions / Supabase rag-query.
VITE_HORUS_RAG=on

# ============================================
# ANTHROPIC CLAUDE API (OPTIONAL / RESERVED)
# ============================================
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================
# INTERVIEW COACH MCP (REQUIRED FOR LIVE INTERVIEW PREP)
# ============================================
# Base URL of the running interview-coach-mcp server. When set, the Interview
# Prep page routes question generation, answer evaluation, final grading and
# source-backed resources/tips through it (real Gemini gateway + Hacker News
# grounding + RLS-scoped Supabase). When UNSET or unreachable, those features
# show "not available at the moment" — never mock data.
VITE_INTERVIEW_MCP_URL=http://localhost:8787

# ============================================
# AZURE FUNCTIONS (LEGACY — being retired)
# ============================================
# No VITE_ variables here any more. These are read server-side by the
# azure-*-proxy edge functions, which hold the key so the browser never sees
# it. Retrieval and graph traversal have already moved to Horus; what remains
# on this stack is:
#   azure-rag-proxy    → fetch-tables      (DataTableVisualizer)
#   azure-graph-proxy  → simulate_scenario, get_alerts, forecast_impacts,
#                        aggregate_impacts  (ScenarioModeler, ProactiveImpactAlerts,
#                        MarketTrends, IntelligenceOverview, CareerExplorer)
#   agentic-planner, intersection-reasoning  (useAgenticRAG)
# Delete these once each has a Horus equivalent.

# ============================================
# AZURE COSMOS DB (GREMLIN API) - FOR GRAPH RAG
# ============================================
# Deploy with: az deployment group create --resource-group rg-careercraft-dev --template-file infrastructure/cosmos-graph.bicep
COSMOS_GREMLIN_ENDPOINT=wss://careercraft-graph.gremlin.cosmos.azure.com:443/
COSMOS_PRIMARY_KEY=your-cosmos-primary-key-here
COSMOS_DATABASE=graphdb
COSMOS_GRAPH=career-graph

# Get the key with:
# az cosmosdb keys list --name careercraft-graph --resource-group rg-careercraft-dev --query primaryMasterKey -o tsv
# ============================================
# PLAN QUOTAS & METERING (Supabase edge secrets)
# ============================================
# Which resources actually REFUSE a request when the allowance is spent.
# Unset or empty means every resource observes only: usage is resolved and
# recorded, near-misses are logged as "[quota:observe] would deny …", and
# nobody is blocked. That is the correct state until token_usage_ledger has
# enough real traffic to tune the seeded limits against — they are guesses.
#
#   (unset)                        observe everything, refuse nothing
#   horus-rag-search               enforce one resource
#   ats-analyze,parse-resume       enforce several
#   all                            enforce everywhere
#
# Roll out most-exposed first: horus-rag-search, then ats-analyze (up to four
# model calls per request), then parse-resume (separate Azure bill), then the
# rest. Because this is a secret and not code, backing a limit out is a
# dashboard change rather than a deploy.
QUOTA_ENFORCE=

# Retires infer's legacy shared-secret-only mode. Leave unset until the
# interview-coach MCP forwards the user JWT it already receives from the
# browser; setting it before then breaks every coach endpoint.
INFER_REQUIRE_JWT=

# Shared secret the MCP presents to the infer function.
INFER_SHARED_SECRET=your-infer-shared-secret-here
