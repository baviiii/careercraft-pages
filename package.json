{
  "name": "careercraft-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web": "cd packages/careercraft-web && npm run dev",
    "build:web": "cd packages/careercraft-web && npm run build"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
