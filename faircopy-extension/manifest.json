{
  "manifest_version": 3,
  "name": "Faircopy: Save job",
  "short_name": "Faircopy",
  "version": "0.1.0",
  "description": "Save the job ad you're looking at to your Faircopy tracker, with the full description.",
  "homepage_url": "https://www.faircopy.au",
  "action": {
    "default_title": "Save this job to Faircopy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "options_page": "options.html"
}
